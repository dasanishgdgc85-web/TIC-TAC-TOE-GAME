def print_board(board):
    """Displays the current state of the game board."""
    print(f"\n {board[0]} | {board[1]} | {board[2]} ")
    print("-----------")
    print(f" {board[3]} | {board[4]} | {board[5]} ")
    print("-----------")
    print(f" {board[6]} | {board[7]} | {board[8]} \n")

def check_winner(board):
    """Returns the winner ('X' or 'O') or None if no one has won yet."""
    win_conditions = [
        (0, 1, 2), (3, 4, 5), (6, 7, 8), # Horizontal
        (0, 3, 6), (1, 4, 7), (2, 5, 8), # Vertical
        (0, 4, 8), (2, 4, 6)             # Diagonal
    ]
    for a, b, c in win_conditions:
        if board[a] == board[b] == board[c] and board[a] != " ":
            return board[a]
    return None

def tic_tac_toe():
    board = [" "] * 9
    current_player = "X"
    
    print("Welcome to Tic-Tac-Toe!")
    print("Positions are numbered 1-9 (Top-left to Bottom-right).")

    for turn in range(9):
        print_board(board)
        
        # Validating input
        try:
            move = int(input(f"Player {current_player}, enter a position (1-9): ")) - 1
            if board[move] != " ":
                print("That spot is already taken! Try again.")
                continue # Skip the rest of the loop and retry the turn
        except (ValueError, IndexError):
            print("Invalid input. Please enter a number between 1 and 9.")
            continue

        board[move] = current_player
        
        # Check for winner
        winner = check_winner(board)
        if winner:
            print_board(board)
            print(f"Congratulations! Player {winner} wins!")
            return

        # Switch players
        current_player = "O" if current_player == "X" else "X"

    print_board(board)
    print("It's a tie!")

if __name__ == "__main__":
    tic_tac_toe()
