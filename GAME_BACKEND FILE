 # ── Game Logic ────────────────────────────────────────────────────────────
    def _on_click(self, idx: int):
        if self.game_over or self.board[idx]:
            return
        self.board[idx] = self.current

        clr = X_CLR if self.current == "X" else O_CLR
        sym = "✕" if self.current == "X" else "○"
        self.buttons[idx].config(text=sym, fg=clr, disabledforeground=clr)

        win_line = self._check_win(self.current)
        if win_line:
            self._end_game(winner=self.current, line=win_line)
        elif "" not in self.board:
            self._end_game(winner=None, line=None)
        else:
            self.current = "O" if self.current == "X" else "X"
            nxt_clr = O_CLR if self.current == "O" else X_CLR
            sym2    = "○" if self.current == "O" else "✕"
            self.status_var.set(f"Player  {sym2}  to move")
            self.status_lbl.config(fg=nxt_clr)

    def _check_win(self, player: str):
        for line in self.WIN_LINES:
            if all(self.board[i] == player for i in line):
                return line
        return None

    def _end_game(self, winner, line):
        self.game_over = True
        if winner:
            self.scores[winner] += 1
            sym = "✕" if winner == "X" else "○"
            self.status_var.set(f"Player  {sym}  wins! 🎉")
            self.status_lbl.config(fg=WIN_CLR)
            for i in line:
                self.buttons[i].config(bg=BTN_HOV, fg=WIN_CLR)
        else:
            self.scores["Draw"] += 1
            self.status_var.set("It's a Draw! 🤝")
            self.status_lbl.config(fg=TXT_CLR)
        self._build_scoreboard()
        # Disable all cells
        for btn in self.buttons:
            btn.config(state="disabled")

    def _new_game(self):
        self.board     = [""] * 9
        self.current   = "X"
        self.game_over = False
        for btn in self.buttons:
            btn.config(text="", fg=TXT_CLR, bg=GRID_CLR, state="normal")
        self.status_var.set("Player  ✕  to move")
        self.status_lbl.config(fg=X_CLR)


