import tkinter as tk
from tkinter import font as tkfont
import sys

# ── Palette ──────────────────────────────────────────────────────────────────
BG        = "#0f0f1a"
GRID_CLR  = "#1e1e32"
X_CLR     = "#ff4d6d"
O_CLR     = "#4cc9f0"
TXT_CLR   = "#e0e0ff"
WIN_CLR   = "#f8e16c"
BTN_BG    = "#1e1e32"
BTN_HOV   = "#2a2a48"
SCORE_BG  = "#16162a"


class TicTacToe:
    def __init__(self, root: tk.Tk):
        self.root = root
        self.root.title("Tic · Tac · Toe")
        self.root.resizable(False, False)
        self.root.configure(bg=BG)

        self._setup_fonts()
        self._init_state()
        self._build_ui()

    # ── Fonts ─────────────────────────────────────────────────────────────────
    def _setup_fonts(self):
        self.f_title  = tkfont.Font(family="Courier New", size=22, weight="bold")
        self.f_cell   = tkfont.Font(family="Courier New", size=42, weight="bold")
        self.f_status = tkfont.Font(family="Courier New", size=13)
        self.f_score  = tkfont.Font(family="Courier New", size=11)
        self.f_btn    = tkfont.Font(family="Courier New", size=10, weight="bold")

    # ── State ─────────────────────────────────────────────────────────────────
    def _init_state(self):
        self.board        = [""] * 9
        self.current      = "X"
        self.game_over    = False
        self.scores       = {"X": 0, "O": 0, "Draw": 0}
        self.WIN_LINES    = [
            (0,1,2),(3,4,5),(6,7,8),
            (0,3,6),(1,4,7),(2,5,8),
            (0,4,8),(2,4,6),
        ]

    # ── UI Build ──────────────────────────────────────────────────────────────
    def _build_ui(self):
        pad = dict(padx=20, pady=10)

        # Title
        tk.Label(
            self.root, text="TIC · TAC · TOE",
            font=self.f_title, bg=BG, fg=TXT_CLR
        ).pack(pady=(20, 5))

        # Scoreboard
        self.score_frame = tk.Frame(self.root, bg=SCORE_BG, bd=0)
        self.score_frame.pack(fill="x", padx=20, pady=(0, 10))
        self._build_scoreboard()

        # Status label
        self.status_var = tk.StringVar(value="Player  X  to move")
        self.status_lbl = tk.Label(
            self.root, textvariable=self.status_var,
            font=self.f_status, bg=BG, fg=X_CLR
        )
        self.status_lbl.pack(pady=(0, 8))

        # Grid
        grid_outer = tk.Frame(self.root, bg=BG)
        grid_outer.pack(padx=20, pady=5)
        self.buttons: list[tk.Button] = []
        for i in range(9):
            r, c = divmod(i, 3)
            btn = tk.Button(
                grid_outer,
                text="", width=4, height=2,
                font=self.f_cell,
                bg=GRID_CLR, fg=TXT_CLR,
                activebackground=BTN_HOV, activeforeground=TXT_CLR,
                relief="flat", bd=0,
                cursor="hand2",
                command=lambda idx=i: self._on_click(idx)
            )
            btn.grid(row=r, column=c, padx=4, pady=4, ipadx=8, ipady=8)
            self.buttons.append(btn)

        # Buttons row
        btn_row = tk.Frame(self.root, bg=BG)
        btn_row.pack(pady=(12, 20))
        for txt, cmd in [("New Game", self._new_game), ("Quit", self.root.quit)]:
            b = tk.Button(
                btn_row, text=txt, font=self.f_btn,
                bg=BTN_BG, fg=TXT_CLR,
                activebackground=BTN_HOV, activeforeground=WIN_CLR,
                relief="flat", bd=0, padx=18, pady=6,
                cursor="hand2", command=cmd
            )
            b.pack(side="left", padx=8)

    def _build_scoreboard(self):
        for w in self.score_frame.winfo_children():
            w.destroy()
        entries = [
            (f"✕  {self.scores['X']}", X_CLR),
            (f"Draw  {self.scores['Draw']}", TXT_CLR),
            (f"{self.scores['O']}  ○", O_CLR),
        ]
        for txt, clr in entries:
            tk.Label(
                self.score_frame, text=txt,
                font=self.f_score, bg=SCORE_BG, fg=clr,
                padx=20, pady=6
            ).pack(side="left", expand=True)

   
